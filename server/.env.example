# Copy this file to .env and fill in the values.

# GCP project ID (shown in the Conversational Agents URL)
PROJECT_ID=new-project-511709

# Agent location: "global" unless you picked a region when creating the agent
LOCATION=global

# Agent ID: the long id after /agents/ in the Conversational Agents URL
AGENT_ID=paste-your-agent-id-here

LANGUAGE_CODE=en
PORT=3000

# Optional: path to a service-account key file.
# Leave unset if you used `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
